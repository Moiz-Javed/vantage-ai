# Rename this file to .env and fill in your keys.

PORT=5000
FRONTEND_URL=http://localhost:5173

# Free at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Free tier at https://cloud.mongodb.com (M0 cluster)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vantage-ai
MONGODB_URI=

# From https://dashboard.clerk.com — API Keys page (free tier)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
