# These get added as Environment Variables in your Vercel project settings
# (not a local .env file, since this deploys as serverless functions).

# Free at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Free tier at https://cloud.mongodb.com (M0 cluster)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vantage-ai
MONGODB_URI=

# From https://dashboard.clerk.com — API Keys page (free tier)
CLERK_SECRET_KEY=

# Your deployed frontend's URL (Vercel gives you this after deploying it) —
# used for CORS so only your frontend can call this API. Use
# http://localhost:5173 while testing locally with `vercel dev`.
FRONTEND_URL=
