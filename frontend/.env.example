# Rename this file to .env and fill in your key.

# From https://dashboard.clerk.com — API Keys page (free tier). Use the
# "Publishable key", not the secret one (that goes in the backend's .env).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Only needed in production. In local dev, Vite's proxy (vite.config.js)
# forwards "/api/..." to http://localhost:5000 automatically — leave this
# blank while developing locally.
VITE_API_URL=
